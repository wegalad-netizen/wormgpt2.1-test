<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/sentinal_card" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="@color/sentinal_panel"
                android:centerColor="@color/sentinal_card"
                android:endColor="@color/sentinal_border" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</layer-list>
