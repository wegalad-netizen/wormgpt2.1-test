<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="12dp"
    android:paddingEnd="20dp"
    android:paddingBottom="8dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="ADD A NUMBER OR PATTERN"
        android:textColor="@color/sentinal_red_bright"
        android:textSize="11sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/numberInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/card_bg"
        android:hint="5550100 or 7414*"
        android:inputType="phone"
        android:padding="12dp"
        android:singleLine="true"
        android:textColor="@color/sentinal_text"
        android:textColorHint="@color/sentinal_faint"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/importButton"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:text="IMPORT"
            android:textColor="@color/sentinal_red_bright"
            android:background="@drawable/pill_outline"
            android:textSize="10sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/exportButton"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:text="EXPORT"
            android:textColor="@color/sentinal_cyan"
            android:background="@drawable/pill_outline"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/trustedButton"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:text="TRUSTED"
            android:textColor="@color/sentinal_emerald"
            android:background="@drawable/pill_outline"
            android:textSize="10sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/strictSmsButton"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:text="STRICT SMS"
            android:textColor="@color/sentinal_amber"
            android:background="@drawable/pill_outline"
            android:textSize="10sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/callHistoryButton"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:text="CALL LOG"
            android:textColor="@color/sentinal_cyan"
            android:background="@drawable/pill_outline"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <EditText
        android:id="@+id/blocklistImportInput"
        android:layout_width="match_parent"
        android:layout_height="84dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/card_bg"
        android:gravity="top|start"
        android:hint="Paste entries here — one per line, e.g. 5550100 or 7414*"
        android:inputType="textMultiLine"
        android:maxLines="4"
        android:padding="10dp"
        android:textColor="@color/sentinal_text"
        android:textColorHint="@color/sentinal_faint"
        android:textSize="11sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="BLOCKED NUMBERS"
        android:textColor="@color/sentinal_faint"
        android:textSize="10sp"
        android:textStyle="bold" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:layout_marginTop="4dp"
        android:fadeScrollbars="true">

        <LinearLayout
            android:id="@+id/numberList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>
</LinearLayout>
