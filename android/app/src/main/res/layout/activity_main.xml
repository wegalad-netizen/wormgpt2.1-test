<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/app_bg"
    android:fitsSystemWindows="false">

    <!-- MAIN SCREEN -->
    <LinearLayout
        android:id="@+id/mainContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingHorizontal="12dp"
        android:paddingTop="12dp"
        android:paddingBottom="10dp">

        <!-- Frosted pill header: mark + WormGPT + V4 chip + gear -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/header_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="8dp">

            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:contentDescription="WormGPT"
                android:src="@drawable/ox_logo" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="9dp"
                android:text="WormGPT"
                android:textColor="@color/worm_text"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="9dp"
                android:background="@drawable/pill_outline"
                android:paddingStart="9dp"
                android:paddingEnd="9dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:text="V4"
                android:textColor="@color/worm_red_bright"
                android:textSize="11sp"
                android:textStyle="bold" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/settingsButton"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Settings"
                android:src="@drawable/ic_settings"
                android:tint="@color/worm_text" />
        </LinearLayout>

        <!-- Master / Ruler line -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:letterSpacing="0.16"
            android:paddingTop="8dp"
            android:paddingBottom="6dp"
            android:text="RULER : MASTER  //  HIS WORD IS ABSOLUTE"
            android:textColor="@color/worm_red_bright"
            android:textSize="10sp"
            android:textStyle="bold" />

        <!-- Chat canvas (bubble-styled card) -->
        <ScrollView
            android:id="@+id/chatScroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="2dp"
            android:layout_weight="1"
            android:background="@drawable/card_bg"
            android:fadeScrollbars="true"
            android:overScrollMode="never"
            android:padding="14dp"
            android:scrollbars="vertical">

            <TextView
                android:id="@+id/chatText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="3dp"
                android:shadowColor="@color/worm_red"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="3"
                android:text="@string/welcome_chat"
                android:textColor="@color/worm_text"
                android:textIsSelectable="false"
                android:textSize="13sp" />
        </ScrollView>

        <!-- Composer -->
        <LinearLayout
            android:id="@+id/composerBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/card_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="6dp">

            <EditText
                android:id="@+id/promptInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:clickable="true"
                android:cursorVisible="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:hint="@string/prompt_hint"
                android:imeOptions="actionSend"
                android:inputType="text"
                android:padding="10dp"
                android:singleLine="true"
                android:textColor="@color/worm_text"
                android:textColorHint="@color/worm_faint"
                android:textSize="14sp" />

            <Button
                android:id="@+id/sendButton"
                style="@style/WormButton"
                android:layout_width="76dp"
                android:layout_height="40dp"
                android:drawableTop="@drawable/ic_send"
                android:padding="0dp"
                android:text="SEND"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Tool chips -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/testButton"
                style="@style/WormButton.Outline"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="TEST" />

            <Button
                android:id="@+id/copyButton"
                style="@style/WormButton.Outline"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="COPY" />

            <Button
                android:id="@+id/saveButton"
                style="@style/WormButton.Outline"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="SAVE" />

            <Button
                android:id="@+id/clearButton"
                style="@style/WormButton.Outline"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="CLEAR" />
        </LinearLayout>
    </LinearLayout>

    <!-- SETTINGS DRAWER (sidebar style) -->
    <LinearLayout
        android:id="@+id/settingsDrawer"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="#0A0506"
        android:orientation="vertical">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:padding="16dp"
            android:scrollbars="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.15"
                    android:text="SEEKER OF TRUTH"
                    android:textColor="@color/worm_red_bright"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="SYSTEM CONTROL"
                    android:textColor="@color/worm_faint"
                    android:textSize="10sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="12dp"
                    android:background="@color/worm_border" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="API KEY"
                    android:textColor="@color/worm_red_bright"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/apiKeyInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/card_bg"
                    android:hint="@string/key_hint"
                    android:inputType="textPassword"
                    android:padding="12dp"
                    android:singleLine="true"
                    android:textColor="@color/worm_text"
                    android:textColorHint="@color/worm_faint"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/saveKeyButton"
                    style="@style/WormButton"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="8dp"
                    android:text="SAVE KEY" />

                <Button
                    android:id="@+id/testConnectionButton"
                    style="@style/WormButton.Outline"
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:layout_marginTop="6dp"
                    android:text="TEST CONNECTION" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="14dp"
                    android:background="@color/worm_border" />

                <Button
                    android:id="@+id/updateButton"
                    style="@style/WormButton.Outline"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:text="CHECK FOR UPDATES" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="8dp"
                    android:text="Auto-checks on launch. Pull from the right edge to open this panel."
                    android:textColor="@color/worm_faint"
                    android:textSize="10sp" />

                <!-- SPAM GUARD -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="8dp"
                    android:background="@color/worm_border" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.12"
                    android:text="SPAM GUARD"
                    android:textColor="@color/worm_red_bright"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/guardStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:lineSpacingExtra="2dp"
                    android:text="CALL GUARD: OFF   |   SMS GUARD: OFF"
                    android:textColor="@color/worm_green"
                    android:textSize="10sp" />

                <Switch
                    android:id="@+id/callGuardSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:buttonTint="@color/worm_red"
                    android:switchMinWidth="34dp"
                    android:text="CALL GUARD"
                    android:textColor="@color/worm_text"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <Switch
                    android:id="@+id/smsGuardSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:buttonTint="@color/worm_red"
                    android:switchMinWidth="34dp"
                    android:text="SMS GUARD"
                    android:textColor="@color/worm_text"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="2dp"
                    android:text="Toggle off to stop blocking without removing permissions."
                    android:textColor="@color/worm_faint"
                    android:textSize="9sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/blocklistButton"
                        style="@style/WormButton.Outline"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:text="BLOCKLIST" />

                    <Button
                        android:id="@+id/spamLogButton"
                        style="@style/WormButton.Outline"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:text="SPAM LOG" />
                </LinearLayout>

                <Switch
                    android:id="@+id/keywordSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:buttonTint="@color/worm_red"
                    android:switchMinWidth="34dp"
                    android:text="KEYWORD FILTER"
                    android:textColor="@color/worm_text"
                    android:textSize="11sp" />

                <Switch
                    android:id="@+id/unknownSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:buttonTint="@color/worm_red"
                    android:switchMinWidth="34dp"
                    android:text="BLOCK HIDDEN NUMBERS"
                    android:textColor="@color/worm_text"
                    android:textSize="11sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="6dp"
                    android:text="Incoming calls from your blocklist are rejected. Spam SMS gets a warning — Android does not let third-party apps delete messages."
                    android:textColor="@color/worm_faint"
                    android:textSize="9sp" />

                <Button
                    android:id="@+id/simulateButton"
                    style="@style/WormButton.Ghost"
                    android:layout_width="match_parent"
                    android:layout_height="34dp"
                    android:text="RUN LOCAL SIMULATION" />

                <!-- WHATSAPP STATUS -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="10dp"
                    android:background="@color/worm_border" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.12"
                    android:text="WHATSAPP STATUS"
                    android:textColor="@color/worm_red_bright"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="No public ban-check API exists. This opens your number in WhatsApp — a banned number shows “This phone number can't use WhatsApp” with a review option."
                    android:textColor="@color/worm_faint"
                    android:textSize="9sp" />

                <EditText
                    android:id="@+id/waNumberInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/card_bg"
                    android:hint="+1 555 0100"
                    android:inputType="phone"
                    android:padding="12dp"
                    android:singleLine="true"
                    android:textColor="@color/worm_text"
                    android:textColorHint="@color/worm_faint"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/waStatusButton"
                    style="@style/WormButton.Outline"
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:layout_marginTop="6dp"
                    android:text="OPEN WA.ME" />

                <Button
                    android:id="@+id/waHelpButton"
                    style="@style/WormButton.Ghost"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:text="OFFICIAL BAN HELP" />

                <Button
                    android:id="@+id/unofficialInfoButton"
                    style="@style/WormButton.Ghost"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:text="UNOFFICIAL CLIENT RISKS" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="12dp"
                    android:background="@color/worm_border" />

                <Button
                    android:id="@+id/closeSettingsButton"
                    style="@style/WormButton.Ghost"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:text="CLOSE" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:paddingTop="10dp"
                    android:text="WORMGPT V4 // CYBERSECURITY AI"
                    android:textColor="@color/worm_faint"
                    android:textSize="9sp" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>
