<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/app_bg"
    android:fitsSystemWindows="true">

    <!-- MAIN SCREEN -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:animateLayoutChanges="true"
        android:orientation="vertical"
        android:padding="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/header_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="10dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:letterSpacing="0.12"
                android:shadowColor="#FF0000"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="6"
                android:text="WORMGPT"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="v2.1"
                android:textColor="@color/worm_neon"
                android:textSize="11sp" />

            <ImageButton
                android:id="@+id/settingsButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="6dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Settings"
                android:src="@drawable/ic_settings"
                android:tint="#FFFFFF" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:letterSpacing="0.18"
            android:padding="6dp"
            android:text="RULER : MASTER  //  HIS WORD IS ABSOLUTE"
            android:textColor="@color/worm_neon"
            android:textSize="10sp"
            android:textStyle="bold" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="4dp"
            android:layout_weight="1"
            android:background="@drawable/chat_bg"
            android:fadeScrollbars="true"
            android:overScrollMode="never"
            android:padding="10dp"
            android:scrollbars="vertical">

            <TextView
                android:id="@+id/chatText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:shadowColor="#39FF14"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="2"
                android:text="@string/welcome_chat"
                android:textColor="@color/worm_neon"
                android:textIsSelectable="true"
                android:textSize="13sp" />
        </ScrollView>

        <EditText
            android:id="@+id/promptInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/chat_bg"
            android:hint="@string/prompt_hint"
            android:imeOptions="actionSend"
            android:padding="12dp"
            android:singleLine="true"
            android:textColor="@color/worm_neon"
            android:textColorHint="#66FF88" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/sendButton"
                style="@style/WormButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="SEND" />

            <Button
                android:id="@+id/testButton"
                style="@style/WormButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="TEST" />

            <Button
                android:id="@+id/copyButton"
                style="@style/WormButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="COPY" />

            <Button
                android:id="@+id/saveButton"
                style="@style/WormButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="SAVE" />

            <Button
                android:id="@+id/clearButton"
                style="@style/WormButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="CLEAR" />
        </LinearLayout>
    </LinearLayout>

    <!-- SETTINGS DRAWER -->
    <LinearLayout
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="#120404"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:letterSpacing="0.15"
            android:shadowColor="#39FF14"
            android:shadowRadius="4"
            android:text="SEEKER OF TRUTH"
            android:textColor="@color/worm_neon"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SYSTEM CONTROL"
            android:textColor="#AA5555"
            android:textSize="10sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="12dp"
            android:background="#7F0000" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="API KEY"
            android:textColor="@color/worm_red"
            android:textSize="11sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/apiKeyInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/chat_bg"
            android:hint="@string/key_hint"
            android:inputType="textPassword"
            android:padding="10dp"
            android:singleLine="true"
            android:textColor="@color/worm_neon"
            android:textColorHint="#66FF88" />

        <Button
            android:id="@+id/saveKeyButton"
            style="@style/WormButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="SAVE KEY" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="14dp"
            android:background="#7F0000" />

        <Button
            android:id="@+id/updateButton"
            style="@style/WormButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CHECK FOR UPDATES" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:text="Auto-checks on launch. Pull from the right edge to open this panel."
            android:textColor="#AA5555"
            android:textSize="10sp" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/closeSettingsButton"
            style="@style/WormButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CLOSE" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="10dp"
            android:text="WORMGPT v2.1 // MASTER BUILD"
            android:textColor="#7F0000"
            android:textSize="9sp" />
    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>
