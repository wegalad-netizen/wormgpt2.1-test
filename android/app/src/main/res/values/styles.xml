<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.WormGPT" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/worm_red</item>
        <item name="colorPrimaryDark">@color/worm_red_dark</item>
        <item name="colorAccent">@color/worm_green</item>
        <item name="android:windowBackground">@color/worm_bg</item>
        <item name="android:textColorPrimary">@color/worm_text</item>
        <item name="android:textColorSecondary">@color/worm_green</item>
    </style>

    <style name="WormButton" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/button_bg</item>
        <item name="android:textColor">@color/worm_text</item>
        <item name="android:textSize">11sp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">42dp</item>
    </style>

</resources>
